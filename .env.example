# Her Second Skin PK - Environment Configuration Template
# COPY THIS FILE TO .env AND SET APPROPRIATE VALUES FOR YOUR ENVIRONMENT.
# NEVER COMMIT SENSITIVE TOKENS OR SECRETS TO SOURCE CONTROL.

# Environment Mode: 'development', 'test', or 'production'
NODE_ENV=development

# Server Networking
PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8787

# Persistent Storage Locations (Set to /var/data on Render with Persistent Disk)
# HSS_DATA_DIR=/var/data
# HSS_DATABASE_PATH=/var/data/her-second-skin.sqlite
# HSS_UPLOAD_DIR=/var/data/uploads

# Admin Authentication
ADMIN_USER=admin
# Provide SHA-256 hash or secure password via initial setup
# ADMIN_PASSWORD_HASH=

# Cookie & Session Security (Must be 32+ random hex characters in production)
SESSION_SECRET=change-this-to-a-secure-random-secret-key-in-production

# Emergency Kill-Switch for Promo Codes (0 = normal, 1 = all promos disabled)
DISABLE_ALL_PROMOS=0

# WhatsApp Cloud API Configuration
# In development/testing, keep WHATSAPP_AUTOMATION_ENABLED=0 to prevent unwanted messages
WHATSAPP_AUTOMATION_ENABLED=0
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_NUMBER=03001234567

# Meta Webhook Verification & HMAC Signing Secret
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_FLOW_ID=
